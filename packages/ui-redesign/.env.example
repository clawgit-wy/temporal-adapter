# ============================================================
# 环境变量模板 - 复制为 .env.{mode}.local 覆盖默认值
# 优先级：.env.{mode}.local > .env.{mode} > .env
# 仅 VITE_ 前缀的变量会暴露给前端代码
# ============================================================

# 环境标识：development / test / production
VITE_APP_ENV=development

# 应用元信息
VITE_APP_NAME=Temporal UI Redesign
VITE_APP_VERSION=0.1.0

# 默认命名空间
VITE_TEMPORAL_NAMESPACE=default

# 主题默认值：dark / light / system
VITE_DEFAULT_THEME=dark

# API 基础路径（前端使用，Nginx 反代到后端）
VITE_API_BASE_URL=/api/v1

# 部署根路径（如 /ui-redesign/）
VITE_BASE_PATH=/

# 静态资源 CDN 前缀
VITE_CDN_BASE=

# 开关项
VITE_ENABLE_DEVTOOLS=true
VITE_ENABLE_SOURCEMAP=true
VITE_LOG_API_REQUESTS=true
VITE_USE_MOCK=false

# 仅 dev/test 用，不会被前端读取
# 注意：docker-compose.temporal-stack.yml 中端口映射为 8280:8080（宿主机 8280 -> 容器 8080）
DEV_TEMPORAL_UI_SERVER=http://localhost:8280
TEST_TEMPORAL_UI_SERVER=http://test-temporal.example.com:8280
PROD_TEMPORAL_UI_SERVER=http://prod-temporal.example.com:8280
