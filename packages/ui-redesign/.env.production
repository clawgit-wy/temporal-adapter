# ============================================================
# 生产环境（production）
# 启动方式：pnpm build（默认 mode=production）
# 后端：生产环境 Temporal UI Server（域名或内网地址）
# ============================================================

# 环境标识
VITE_APP_ENV=production

# 是否启用开发者工具（生产环境关闭）
VITE_ENABLE_DEVTOOLS=false

# 是否开启 sourcemap（生产环境关闭以减小体积；如需线上排错可改为 'hidden'）
VITE_ENABLE_SOURCEMAP=false

# 是否在控制台打印 API 请求日志（生产环境关闭）
VITE_LOG_API_REQUESTS=false

# 生产环境 Temporal UI Server 地址
# 注意：前端运行时通过 Nginx 反向代理 /api/v1，不直接使用此值
# 此值仅用于构建期参考文档生成
PROD_TEMPORAL_UI_SERVER=http://prod-temporal.example.com:8080

# 是否启用 Mock API（生产环境必须为 false）
VITE_USE_MOCK=false

# 部署根路径
VITE_BASE_PATH=/

# 静态资源 CDN 前缀（如使用 CDN，可配置为 https://cdn.example.com/ui-redesign/）
# 留空表示与 HTML 同源
VITE_CDN_BASE=
