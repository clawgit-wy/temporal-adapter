# ============================================================
# 开发环境（development）
# 启动方式：pnpm dev 或 pnpm dev:mock
# 后端：本地 Temporal UI Server (localhost:8080)，由 Vite 代理转发
# ============================================================

# 环境标识
VITE_APP_ENV=development

# 是否启用开发者工具（详细日志、React DevTools 提示等）
VITE_ENABLE_DEVTOOLS=true

# 是否开启 sourcemap
VITE_ENABLE_SOURCEMAP=true

# 是否在控制台打印 API 请求日志
VITE_LOG_API_REQUESTS=true

# Temporal UI Server 地址（仅 Vite proxy 使用，前端代码不应直接读取此值）
# 修改此值需同步修改 vite.config.ts 的 proxy.target
# 注意：docker-compose.temporal-stack.yml 中端口映射为 8280:8080（宿主机 8280 -> 容器 8080）
DEV_TEMPORAL_UI_SERVER=http://localhost:8280

# 是否启用 Mock API
VITE_USE_MOCK=false

# 开发服务器端口
VITE_DEV_PORT=5173
