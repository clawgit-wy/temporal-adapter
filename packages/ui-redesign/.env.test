# ============================================================
# 测试环境（test / staging）
# 启动方式：pnpm build --mode test，预览：pnpm preview:test
# 后端：测试环境 Temporal UI Server（域名或内网地址）
# ============================================================

# 环境标识
VITE_APP_ENV=test

# 是否启用开发者工具（测试环境保留以方便排查）
VITE_ENABLE_DEVTOOLS=true

# 是否开启 sourcemap（便于排查测试环境问题）
VITE_ENABLE_SOURCEMAP=true

# 是否在控制台打印 API 请求日志
VITE_LOG_API_REQUESTS=true

# 测试环境 Temporal UI Server 地址（构建期注入，运行期由 Nginx 反代）
TEST_TEMPORAL_UI_SERVER=http://test-temporal.example.com:8080

# 是否启用 Mock API
VITE_USE_MOCK=false

# 部署根路径（测试环境常挂在子路径下，例如 /ui-redesign/）
# 留空表示根路径部署
VITE_BASE_PATH=/
