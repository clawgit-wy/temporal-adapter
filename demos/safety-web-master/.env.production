# 是否启用mock
VITE_USE_MOCK = false

# 发布路径
VITE_PUBLIC_PATH = /

# 控制台不输出
VITE_DROP_CONSOLE = true

# 是否启用gzip或brotli压缩
# 选项值: gzip | brotli | none
# 如果需要多个可以使用“,”分隔
VITE_BUILD_COMPRESS = 'gzip'

# 使用压缩时是否删除原始文件，默认为false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false

# 单点登录服务端地址
VITE_GLOB_APP_CAS_BASE_URL=https://mp.yutong.com/mpapi/iam-web/authz/

#后台接口父地址(必填)
VITE_GLOB_API_URL=/web

#后台接口全路径地址(必填)
VITE_GLOB_DOMAIN_URL=https://an.yutong.com/web

# 接口父路径前缀
VITE_GLOB_API_URL_PREFIX=

# 是否启用图像压缩
VITE_USE_IMAGEMIN= true

#单点登录编码
VITE_GLOB_APP_CAS_APPID='466f84de4ae14448947c74231300e108'

#eip流程跳转链接
VITE_GLOB_EIP_URL='http://ekp.yutong.com/ekp/km/review/km_review_main/kmReviewMain.do?method=view&fdId='

#bpm iframe地址
VITE_GLOB_BPM_URL='https://bpm.yutong.com/sys/lbpmdocking/lbpm_docking_main/lbpmDockingMain.do'

#安保离线包地址
VITE_GLOB_ANBAO_URI='http://eyutong_open/com.yutong.security.one.services'

# 使用pwa
VITE_USE_PWA = false

# 是否兼容旧浏览器
VITE_LEGACY = true

#EIP首页
VITE_GLOB_EIP_URI='http://eip.yutong.com/static/portal/home'

