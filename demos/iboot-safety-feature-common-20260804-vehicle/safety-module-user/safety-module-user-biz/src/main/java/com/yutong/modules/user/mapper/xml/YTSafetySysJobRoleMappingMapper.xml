<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yutong.modules.user.mapper.YTSafetySysJobRoleMappingMapper">

    <select id="selectPageList" resultType="com.yutong.modules.user.vo.YTSafetySysJobRoleMappingVO">
        SELECT
            id,
            job_code,
            job_name,
            role_id,
            role_name
        FROM ytsafety_sys_job_role_mapping
        WHERE del_flag = 0
        <if test="jobName != null and jobName != ''">
            AND job_name LIKE CONCAT('%', #{jobName}, '%')
        </if>
        <if test="roleName != null and roleName != ''">
            AND role_name LIKE CONCAT('%', #{roleName}, '%')
        </if>
        ORDER BY update_time DESC
    </select>
</mapper>