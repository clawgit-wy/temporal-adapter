<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>safety-module-build</artifactId>
        <groupId>com.yutong.iboot</groupId>
        <version>3.5.0</version>
    </parent>

    <artifactId>safety-module-build-biz</artifactId>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.yutong.iboot</groupId>
            <artifactId>safety-base-core</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>

        <!-- API-->
        <dependency>
            <groupId>com.yutong.iboot</groupId>
            <artifactId>safety-module-build-api</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
        <dependency>
            <groupId>com.yutong.iboot</groupId>
            <artifactId>safety-module-user-api</artifactId>
            <version>${jeecgboot.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.yutong.iboot</groupId>
            <artifactId>safety-module-common-api</artifactId>
            <version>${jeecgboot.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- MapStruct 核心 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.4.2.Final</version>
        </dependency>

        <!-- 注解处理器（必须） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>1.4.2.Final</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>lock4j-core</artifactId>
            <version>2.2.5</version>
            <scope>compile</scope>
        </dependency>
        <!-- Quartz定时任务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- xxjob -->
        <dependency>
            <groupId>org.jeecgframework.boot</groupId>
            <artifactId>jeecg-boot-starter-job</artifactId>
            <version>${jeecgboot.version}</version>
        </dependency>
    </dependencies>

</project>