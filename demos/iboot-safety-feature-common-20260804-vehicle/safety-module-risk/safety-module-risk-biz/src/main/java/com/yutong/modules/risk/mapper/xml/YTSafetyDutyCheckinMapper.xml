    <sql id="Base_Column_List">
        id, factory_id, location_id, emp_no, emp_name, phone_no, person_type, factory, position,
        location, department_team, shift_code, shift_start_time, shift_end_time, duty_date, checkin_time, clock_in_time, clock_out_time, duty_status,
        is_makeup, apply_reason, apply_time, approve_user, approve_remark,
        create_user, create_by, create_time, update_user, update_by, update_time, del_flag,
        model_flag, flow_code, flow_subject
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM ytsafety_duty_checkin
        <where>
            del_flag = 0
            <if test="param.factoryId != null">
                AND factory_id = #{param.factoryId}
            </if>
            <if test="param.empNo != null and param.empNo != ''">
                AND emp_no LIKE CONCAT('%', #{param.empNo}, '%')
            </if>
            <if test="param.empName != null and param.empName != ''">
                AND emp_name LIKE CONCAT('%', #{param.empName}, '%')
            </if>
            <if test="param.personType != null and param.personType != ''">
                AND person_type = #{param.personType}
            </if>
            <if test="param.position != null and param.position != ''">
                AND position LIKE CONCAT('%', #{param.position}, '%')
            </if>
            <if test="param.location != null and param.location != ''">
                AND location LIKE CONCAT('%', #{param.location}, '%')
            </if>
            <if test="param.factory != null and param.factory != ''">
                AND factory LIKE CONCAT('%', #{param.factory}, '%')
            </if>
            <if test="param.dutyDate != null and param.dutyDate != ''">
                AND duty_date = #{param.dutyDate}
            </if>
            <if test="param.dutyStatus != null">
                AND duty_status = #{param.dutyStatus}
            </if>
            <if test="param.isMakeup != null">
                AND is_makeup = #{param.isMakeup}
            </if>
        </where>
        ORDER BY duty_date DESC, create_time DESC
    </select>

    <select id="selectPageListVO" resultMap="PageVOResultMap">
        SELECT
            d.id, d.factory_id, d.location_id, d.emp_no,
            d.emp_name, d.phone_no, d.position,
            (SELECT sdi.item_name FROM safety_dict_item sdi WHERE sdi.supper_code = 'person_type' AND sdi.item_code = d.person_type) AS person_type,
            d.factory, d.location, d.department_team, d.shift_code,
            d.shift_start_time, d.shift_end_time, d.duty_date, d.checkin_time, d.clock_in_time, d.clock_out_time,
            CASE d.duty_status WHEN 1 THEN '在岗' ELSE '未在岗' END AS duty_status,
            d.is_makeup, d.apply_reason, d.apply_time, d.approve_user, d.approve_remark,
            d.create_user, d.create_by, d.create_time, d.update_user, d.update_by, d.update_time, d.del_flag,
            d.model_flag, d.flow_code, d.flow_subject
        FROM ytsafety_duty_checkin d
        <where>
            d.del_flag = 0
            <if test="param.factoryId != null">
                AND d.factory_id = #{param.factoryId}
            </if>
            <if test="param.empNo != null and param.empNo != ''">
                AND d.emp_no LIKE CONCAT('%', #{param.empNo}, '%')
            </if>
            <if test="param.empName != null and param.empName != ''">
                AND d.emp_name LIKE CONCAT('%', #{param.empName}, '%')
            </if>
            <if test="param.personType != null and param.personType != ''">
                AND d.person_type = #{param.personType}
            </if>
            <if test="param.position != null and param.position != ''">
                AND d.position LIKE CONCAT('%', #{param.position}, '%')
            </if>
            <if test="param.location != null and param.location != ''">
                AND d.location LIKE CONCAT('%', #{param.location}, '%')
            </if>
            <if test="param.factory != null and param.factory != ''">
                AND d.factory LIKE CONCAT('%', #{param.factory}, '%')
            </if>
            <!-- 值班日期过滤 -->
            <if test="param.dutyDate != null and param.dutyDate != ''">
                <choose>
                    <when test="param.today">
                        <!-- 实时：未下班打卡 且（有班次并签到 或 已到上班时间） -->
                        AND d.clock_out_time IS NULL
                        AND (
                            (d.duty_status = 1 AND DATE(d.shift_start_time) = d.duty_date)
                            OR d.shift_start_time <![CDATA[ <= ]]> NOW()
                        )
                    </when>
                    <otherwise>
                        <!-- 历史：班次与查询日期有交集 -->
                        AND (DATE(d.shift_start_time) = #{param.dutyDate}
                             OR DATE(d.shift_end_time) = #{param.dutyDate})
                    </otherwise>
                </choose>
            </if>
            <if test="param.dutyStatus != null">
                AND d.duty_status = #{param.dutyStatus}
            </if>
            <if test="param.isMakeup != null">
                AND d.is_makeup = #{param.isMakeup}
            </if>
        </where>
        ORDER BY d.duty_date DESC, d.create_time DESC
    </select>

