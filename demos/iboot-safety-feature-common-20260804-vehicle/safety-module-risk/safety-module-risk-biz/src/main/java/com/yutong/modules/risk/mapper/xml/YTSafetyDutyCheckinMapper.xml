    <resultMap id="SecurityDutyPersonVOMap" type="com.yutong.modules.risk.vo.SecurityDutyPersonVO">
        <result column="emp_no" jdbcType="VARCHAR" property="empNo"/>
        <result column="emp_name" jdbcType="VARCHAR" property="empName"/>
        <result column="phone_no" jdbcType="VARCHAR" property="phoneNo"/>
        <result column="factory" jdbcType="VARCHAR" property="factory"/>
        <result column="duty_date" jdbcType="VARCHAR" property="dutyDate"/>
        <result column="person_type" jdbcType="VARCHAR" property="personType"/>
    </resultMap>

    <select id="selectDutyPersonByFactory" resultMap="SecurityDutyPersonVOMap">
        SELECT
            d.emp_no,
            d.emp_name,
            d.phone_no,
            d.factory,
            d.duty_date,
            d.person_type
        FROM ytsafety_duty_checkin d
        WHERE d.del_flag = 0
          AND d.person_type = '2'
          AND d.factory = #{factory}
          AND d.duty_date = #{dutyDate}
        ORDER BY d.create_time DESC
        LIMIT 1
    </select>

    <select id="selectByMonthVO" resultMap="MonthVOResultMap">
        SELECT
            d.emp_no, d.emp_name, d.position, d.person_type,
            d.factory, d.location, d.location_id, d.duty_date, d.checkin_time,
            d.duty_status, d.is_makeup
        FROM ytsafety_duty_checkin d
        WHERE d.del_flag = 0
          AND d.duty_date LIKE CONCAT(#{month}, '%')
        ORDER BY d.duty_date DESC, d.create_time DESC
    </select>

