    <!-- 查询用户待办任务分组统计（按 taskType + postType 分组） -->
    <select id="selectPatrolToDo" resultType="com.yutong.modules.risk.vo.PatrolTaskGroupVO">
        SELECT
            t1.task_type AS taskType,
            CASE
                WHEN t1.task_type = 'XCRW' THEN '巡查任务'
                WHEN t1.task_type = 'ZXRW' THEN '专项任务'
                WHEN t1.task_type = 'DDXG' THEN '定点巡更任务'
                WHEN t1.task_type = 'YWYZ' THEN '业务验证'
                WHEN t1.task_type = 'GWYZ' THEN '岗位验证'
                ELSE t1.task_type
            END AS taskTypeName,
            COALESCE(t1.post_type, '') AS postType,
            COUNT(*) AS totalCount,
            SUM(CASE WHEN t.task_status IN ('COMPLETED', 'OVERDUE_COMPLETED') THEN 1 ELSE 0 END) AS completedCount,
            SUM(CASE WHEN t.task_status IN ('RUNNING', 'OVERDUE_UNCOMPLETED') THEN 1 ELSE 0 END) AS pendingCount
        FROM ytsafety_task_execution t
        INNER JOIN ytsafety_task_info t1 ON t.task_info_id = t1.id
        WHERE t.del_flag = 0
          AND t1.del_flag = 0
          AND t.exec_user_id = #{execUserId}
          AND t.task_status IN ('RUNNING', 'COMPLETED', 'OVERDUE_COMPLETED', 'OVERDUE_UNCOMPLETED')
        GROUP BY t1.task_type, t1.post_type
        ORDER BY t1.task_type, t1.post_type
    </select>
