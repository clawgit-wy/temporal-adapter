<select id="selectAttachmentImgList" resultType="com.yutong.modules.common.entity.YTSafetyFileInfo">
    SELECT
        *
    FROM ytsafety_file_info t
    WHERE FIND_IN_SET(t.id, #{id}) > 0
</select>

    <select id="selectAttachmentList" resultType="com.yutong.modules.common.entity.YTSafetyFileInfo">
        SELECT
        *
        FROM ytsafety_file_info t
        WHERE FIND_IN_SET(t.id, #{id}) > 0
    </select>

    <select id="queryPage" resultMap="resultTaskExecutionVO">
        SELECT 
            t.*,
            t1.task_description
        FROM ytsafety_task_execution t
        LEFT JOIN ytsafety_task_info t1 ON t.task_info_id = t1.id
        WHERE t.del_flag = 0
        AND t1.del_flag = 0
        <if test="dto.type != null and dto.type != ''">
            AND t1.task_type = #{dto.type}
        </if>
        <if test="dto.taskDescription != null and dto.taskDescription != ''">
            AND t1.task_description like CONCAT('%', #{dto.taskDescription}, '%')
        </if>
        <if test="dto.taskCode != null and dto.taskCode != ''">
            AND t.task_code = #{dto.taskCode}
        </if>
        <if test="dto.taskName != null and dto.taskName != ''">
            AND t.task_name LIKE CONCAT('%', #{dto.taskName}, '%')
        </if>
        <if test="dto.riskCategoryId != null">
            AND FIND_IN_SET(#{dto.riskCategoryId}, t.risk_category_id) > 0
        </if>
        <if test="dto.execUserName != null and dto.execUserName != ''">
            AND t.exec_user_name LIKE CONCAT('%', #{dto.execUserName}, '%')
        </if>
        <if test="dto.taskStartTimeStart != null and dto.taskStartTimeEnd != null">
            AND DATE(t.task_start_time) BETWEEN #{dto.taskStartTimeStart} AND #{dto.taskStartTimeEnd}
        </if>
        <if test="dto.taskCompleteTimeStart != null and dto.taskCompleteTimeEnd != null">
            AND DATE(t.task_complete_time) BETWEEN #{dto.taskCompleteTimeStart} AND #{dto.taskCompleteTimeEnd}
        </if>
        <if test="dto.endDateStart != null and dto.endDateEnd != null">
            AND DATE(t.end_date) BETWEEN #{dto.endDateStart} AND #{dto.endDateEnd}
        </if>
        <if test="dto.completeIntervalStart != null">
            AND CAST(t.complete_interval AS SIGNED) &gt;= #{dto.completeIntervalStart}
        </if>
        <if test="dto.completeIntervalEnd != null">
            AND CAST(t.complete_interval AS SIGNED) &lt;= #{dto.completeIntervalEnd}
        </if>
        <if test="dto.taskStatus != null and dto.taskStatus != ''">
            AND t.task_status = #{dto.taskStatus}
        </if>
        <if test="dto.isAbnormal != null">
            AND t.is_abnormal = #{dto.isAbnormal}
        </if>
        ORDER BY t.create_time DESC
    </select>

    <select id="exportPatrolMissionQueryPage" resultMap="resultTaskExecutionXCRWExportVO">
        SELECT
        t.*,
        t1.task_description
        FROM ytsafety_task_execution t
        LEFT JOIN ytsafety_task_info t1 ON t.task_info_id = t1.id
