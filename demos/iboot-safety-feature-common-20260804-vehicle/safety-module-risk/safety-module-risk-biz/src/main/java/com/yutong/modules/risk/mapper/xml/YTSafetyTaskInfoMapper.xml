                #{item}
            </foreach>
        </if>
        <if test="dto.areaId!=null and dto.areaId!='' ">
            and t.area_id in
            <foreach collection="dto.areaId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.orgId!=null and dto.orgId!='' ">
            and t.org_id in
            <foreach collection="dto.orgId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.riskLevel!=null and dto.riskLevel!='' ">
            and t.risk_level in
            <foreach collection="dto.riskLevel.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
    </select>

    <update id="setTaskDormancy">
        UPDATE ytsafety_task_info
        SET dormant_date = NOW()
        WHERE id IN
        <foreach collection="ids" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </update>

    <!-- 查询任务列表用于导出 -->
    <select id="queryExportList" resultType="com.yutong.modules.risk.vo.YTSafetyTaskInfoExporVO">
        SELECT t.id,t.task_name,t.task_code,t.task_type,t.risk_category_id,t.task_description,t.start_date,t.dormant_date,
            t.end_date,t.inspection_cycle,t.exec_scope,t.create_name,t.update_name,t.create_time,t.update_time,
            t.post_type,t1.issue_type,t1.personnel_name,t1.personnel_id,t1.personnel_post_id,t1.personnel_post_name,t.task_status
        FROM ytsafety_task_info t
        LEFT JOIN ytsafety_task_info_extension t1 ON t.id = t1.task_info_id
        where t.del_flag = 0
        <if test="dto.taskCode != null and dto.taskCode != ''">
            AND t.task_code  = #{dto.taskCode}
        </if>
        <if test="dto.selections != null and dto.selections != ''">
            AND t.id IN
            <foreach collection="dto.selections.split(',')" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        <if test="dto.taskName != null and dto.taskName != ''">
            AND t.task_name LIKE CONCAT('%', #{dto.taskName}, '%')
        </if>
        <if test="dto.taskType != null and dto.taskType != ''">
            AND t.task_type = #{dto.taskType}
        </if>
        <if test="dto.inspectionCycle != null">
            AND t.inspection_cycle LIKE CONCAT('%', #{dto.inspectionCycle}, '%')
        </if>
        <if test="dto.taskDescription != null and dto.taskDescription != ''">
            AND t.task_description LIKE CONCAT('%', #{dto.taskDescription}, '%')
        </if>
        <if test="dto.execScope != null and dto.execScope != ''">
            AND FIND_IN_SET(#{dto.execScope}, t.exec_scope) > 0
        </if>
        <if test="dto.taskStatus != null and dto.taskStatus != '' ">
            <choose>
                <when test="dto.taskStatus == 'DORMANT'">
                    AND t.dormant_date IS NOT NULL
                </when>
                <otherwise>
                    AND t.task_status = #{dto.taskStatus}
                    AND t.dormant_date IS  NULL
                </otherwise>
            </choose>
        </if>
        <if test="dto.createName != null and dto.createName != ''">
            AND (t.create_user LIKE CONCAT('%', #{dto.createName}, '%') or t.create_name LIKE CONCAT('%', #{dto.createName}, '%'))
        </if>
        <if test="dto.updateUser != null and dto.updateUser != ''">
            AND (t.update_user LIKE CONCAT('%', #{dto.updateUser}, '%') or t.update_name LIKE CONCAT('%', #{dto.updateUser}, '%'))
        </if>
        <if test="dto.startDateStart != null and dto.startDateEnd != null">
            AND t.start_date BETWEEN #{dto.startDateStart} AND #{dto.startDateEnd}
        </if>
        <if test="dto.endDateStart != null and dto.endDateEnd != null">
            AND t.end_date BETWEEN #{dto.endDateStart} AND #{dto.endDateEnd}
        </if>
        <if test="dto.createTimeStart != null and dto.createTimeEnd != null">
            AND DATE(t.create_time) BETWEEN #{dto.createTimeStart} AND #{dto.createTimeEnd}
        </if>
        <if test="dto.updateTimeStart != null and dto.updateTimeEnd != null">
            AND DATE(t.update_time) BETWEEN #{dto.updateTimeStart} AND #{dto.updateTimeEnd}
        </if>
        <if test="dto.dormantDateStart != null and dto.dormantDateEnd != null">
            AND DATE(t.dormant_date) BETWEEN #{dto.dormantDateStart} AND #{dto.dormantDateEnd}
        </if>
        <if test="dto.personnelName != null and dto.personnelName != ''">
            <choose>
                <when test="dto.personnelName != null and ('安全员,安全管理员,安全'.contains(dto.personnelName))">
                    AND t1.issue_type = '1'
                </when>
                <otherwise>
                    and (
                    t1.personnel_name like concat('%',#{dto.personnelName},'%')
                    or  t1.personnel_post_name like concat('%',#{dto.personnelName},'%')
                    )
                </otherwise>
            </choose>
        </if>
        ORDER BY t.create_time DESC
    </select>

    <!--  更新所有待执行任务为执行中  -->
    <update id="updateTaskStatusPening">
        UPDATE ytsafety_task_info t
        INNER JOIN ytsafety_task_info_extension e ON t.id = e.task_info_id
        SET t.task_status = 'RUNNING'
        WHERE t.task_status = 'PENDING'
        AND t.del_flag = 0
        AND DATE(e.current_execution_cycle) = CURDATE()
    </update>

    <!--  更新所有结束日期小于等于当前时间的任务状态为已过期  -->
    <update id="updateTaskStatusExpired">
        update  ytsafety_task_info set task_status = 'EXPIRED'
        where end_date &lt; CURDATE()
        and task_status != 'EXPIRED'
        and del_flag = 0
    </update>


    <!-- 更新所有今天结束但未完成的任务状态为超期未完成-->
    <update id="updateUserTaskExecutionStatus">
        update ytsafety_task_execution set task_status = 'OVERDUE_UNCOMPLETED'
        where end_date &lt; CURDATE()
        and task_complete_time is null
        and task_status != 'OVERDUE_UNCOMPLETED'
    </update>

    <select id="taskAssignment" resultMap="resultTaskInfoVO">
        SELECT t.*, t1.id AS extension_id, t1.task_info_id, t1.factory_id, t1.area_id, t1.org_id, t1.issue_type, t1.task_level, t1.risk_level, t1.exec_type, t1.cycle_type, t1.task_frequency, t1.execution_date, t1.skip_weekend, t1.skip_holiday, t1.personnel_name, t1.personnel_post_name, t1.personnel_id, t1.personnel_post_id, t1.personnel_factory_id, t1.personnel_org_id, t1.current_execution_cycle, t1.file_must, t1.photo_must, t1.issue_approval, t1.approval_user
        FROM ytsafety_task_info t
        LEFT JOIN ytsafety_task_info_extension t1 ON t.id = t1.task_info_id
        <where>
            <choose>
                <when test="taskInfoId != null and taskInfoId != ''">
                    t.id = #{taskInfoId}
                </when>
                <otherwise>
                    t.task_status  = 'RUNNING'
                    AND t1.exec_type !='ONCE'
                    AND (t.dormant_date IS  NULL OR t.dormant_date = '')
                    AND t1.current_execution_cycle = CURDATE()
                </otherwise>
            </choose>
        </where>
    </select>

    <select id="queryHolidayList" resultType="com.yutong.modules.risk.entity.YTSafetyHoliday">
        SELECT * FROM ytsafety_holiday
        WHERE holiday_year = YEAR(CURDATE())
    </select>


    <select id="queryMyTaskList" resultType="com.yutong.modules.risk.vo.YTSafetyMyTaskInfoVO">
        select t.id,t.start_date, t.end_date,
               t1.task_name, t1.task_type, t1.post_type, t1.task_description, t.task_complete_time, t.report_post_id
        from ytsafety_task_execution t
        left join ytsafety_task_info t1 on t.task_info_id = t1.id
        where (t.exec_user_id = #{userId} or t.exec_user_id = #{empNo})
        and FIND_IN_SET(#{execScope}, t1.exec_scope) > 0
        <if test = "startDate!= null and startDate!=''">
            and DATE(t.start_date) >= STR_TO_DATE(#{startDate}, '%Y-%m-%d')
        </if>
        <if test = "endDate!= null and endDate!=''">
            and DATE(t.end_date) &lt;= STR_TO_DATE(#{endDate}, '%Y-%m-%d')
        </if>
        <choose>
            <when test="isCompleted == 1">
                and (t.task_complete_time is not null or t.task_status = 'APPROVAL')
            </when>
            <otherwise>
                and t.task_complete_time is null and t.task_status != 'APPROVAL'
            </otherwise>
        </choose>
        order by t.end_date asc
    </select>

    <select id="getCompletedQuantity" resultType="java.util.Map">
        SELECT
        COUNT(*) AS totalCount,
        COALESCE(SUM(CASE WHEN (t.task_complete_time is not null or t.task_status = 'APPROVAL') THEN 1 ELSE 0 END), 0) AS completedCount
        from ytsafety_task_execution t
        left join ytsafety_task_info t1 on t.task_info_id = t1.id
        where (t.exec_user_id = #{userId} or t.exec_user_id = #{empNo})
        AND FIND_IN_SET(#{execScope}, t1.exec_scope) > 0
        <if test = "startDate!= null and startDate!=''">
            and DATE(t.start_date) >= STR_TO_DATE(#{startDate}, '%Y-%m-%d')
        </if>
        <if test = "endDate!= null and endDate!=''">
            and DATE(t.end_date) &lt;= STR_TO_DATE(#{endDate}, '%Y-%m-%d')
        </if>
    </select>

    <select id="approvefirefighters" resultType="java.lang.String">
        SELECT
        distinct(su.user_name)
        FROM safety_sys_user su
        LEFT JOIN safety_sys_user_role sur ON su.id = sur.user_id AND sur.del_flag = 0
        LEFT join ytsafety_sys_user_depart sud on su.id = sud.user_id
        WHERE su.delete_falg = 0
        and sur.role_code=#{firefighter}
        and sud.depart_code in (
        select depart_code from ytsafety_sys_user_depart
        where user_id=#{userId} )
    </select>
    <select id="getDictItem" resultType="java.util.Map">
        select id,item_name as itemName from safety_dict_item
        where supper_code = 'RISK_TYPE'
        and pid is null
    </select>
    <update id="updateTaskExecutionIsAbnormal">
        update ytsafety_task_execution
            set is_abnormal = 1
        where id = #{taskExecutionId}
    </update>
</mapper>
