    <select id="getTaskDetail" resultMap="resultTaskInfoVO">
        SELECT t.*, e.id AS extension_id, e.task_info_id, e.factory_id, e.area_id, e.org_id, e.issue_type, e.task_level, e.risk_level, e.exec_type, e.cycle_type, e.task_frequency, e.execution_date, e.skip_weekend, e.skip_holiday, e.personnel_name, e.personnel_post_name, e.personnel_id, e.personnel_post_id, e.personnel_factory_id, e.personnel_org_id, e.current_execution_cycle, e.file_must, e.photo_must, e.issue_approval, e.approval_user
        FROM ytsafety_task_info t
        LEFT JOIN ytsafety_task_info_extension e ON t.id = e.task_info_id
        where t.id = #{id}
    </select>

    <select id="getRiskLevelDict" resultType="com.yutong.modules.risk.vo.RiskLevelDictVO">
        select * from ytsafety_risk_level_dict
        order by id asc
    </select>

    <select id="getTaskRiskData" resultType="com.yutong.modules.risk.vo.YtsafetyTaskRiskDataVO">
        SELECT t.risk_code,t.factory_name,t.area_name,t.org_name,t.org_code,t.location_name,t.risk_type_name,t.risk_factor_name,t.check_object,
        t.risk_identify_name,t.risk_description,t.risk_level
        FROM ytsafety_risk_data t
        WHERE t.del_flag = 0
        <if test="dto.riskTypeId!=null and dto.riskTypeId!='' ">
            and t.risk_type_id in
            <foreach collection="dto.riskTypeId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.factoryId!=null and dto.factoryId!='' ">
            and t.factory_id in
            <foreach collection="dto.factoryId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.areaId!=null and dto.areaId!='' ">
            and t.area_id in
            <foreach collection="dto.areaId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.orgId!=null and dto.orgId!='' ">
            and t.org_id in
            <foreach collection="dto.orgId.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="dto.riskLevel!=null and dto.riskLevel!='' ">
            and t.risk_level in
            <foreach collection="dto.riskLevel.split(',')" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        order by t.update_time desc

    </select>

