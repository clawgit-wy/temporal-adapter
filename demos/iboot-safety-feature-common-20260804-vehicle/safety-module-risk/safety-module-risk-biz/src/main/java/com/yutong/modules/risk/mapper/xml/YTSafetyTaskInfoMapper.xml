    <select id="getRiskGradingStandard" resultType="java.lang.String">
        SELECT risk_level FROM ytsafety_risk_level_dict WHERE id IN
        <foreach item="item" collection="ids" separator="," open="(" close=")" index="">
            #{item}
        </foreach>
    </select>

    <select id="getTaskUser" resultType="com.yutong.modules.risk.vo.YtsafetyTaskUserVO">
        SELECT
            su.id AS user_id,
            su.emp_name,
            su.emp_no,
<!--            GROUP_CONCAT(DISTINCT sud.depart_name SEPARATOR ',') AS depart_name,-->
            GROUP_CONCAT(DISTINCT suf.factory_id SEPARATOR ',') AS factory_id,
            GROUP_CONCAT(DISTINCT suf.factory_name SEPARATOR ',') AS power_factory_name
        FROM safety_sys_user su
        LEFT JOIN ytsafety_sys_user_factory suf ON su.id = suf.user_id
        LEFT JOIN safety_sys_user_role sur ON su.id = sur.user_id AND sur.del_flag = 0
        left join ytsafety_sys_user_depart sud ON su.id = sud.user_id
        WHERE su.delete_falg = 0
        <if test="dto.roleCode != null and dto.roleCode != ''">
            AND FIND_IN_SET(sur.role_code, #{dto.roleCode}) > 0
        </if>
        <if test="dto.empNameORempNo != null and dto.empNameORempNo != ''">
            AND (su.emp_name LIKE CONCAT('%', #{dto.empNameORempNo}, '%')
            OR su.emp_no LIKE CONCAT('%', #{dto.empNameORempNo}, '%'))
        </if>
        <if test="dto.orgCode != null and dto.orgCode != ''">
            AND sud.depart_id= #{dto.orgCode}
        </if>
        <if test="dto.factoryId != null and dto.factoryId != ''">
            AND su.id IN (
            SELECT user_id
            FROM ytsafety_sys_user_factory
            WHERE FIND_IN_SET(#{dto.factoryId}, factory_id) > 0
            )
        </if>
        GROUP BY su.id, su.emp_name, su.emp_no
    </select>

