  <select id="getQuestList" parameterType="java.util.Map" resultType="com.yutong.safety.core.db.entity.spot.SafetyPatrolPositionValidQuestDO">
    SELECT t1.*
    FROM safety_patrol_position_valid_quest t1
    inner JOIN (
      SELECT plant_id, max(id) as max_id
      FROM safety_patrol_position_valid_quest
      GROUP BY plant_id
    ) t2 ON t1.id = t2.max_id
    where
      end_date >= #{paramMap.endDate}
