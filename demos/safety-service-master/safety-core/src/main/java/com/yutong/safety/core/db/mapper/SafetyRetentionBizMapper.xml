    <select id="getRetentionNoticeList" resultType="com.yutong.safety.core.db.entity.SafetyRetentionNoticeDO">
        SELECT
            id, retention_hour, car_type, content, remind_rule, remind_num, send_num, remind_gap,
    remind_type, is_used, create_time, create_by, update_time, update_by
        FROM
            safety_retention_notice a
        WHERE
            a.update_time = (
                SELECT
                    max(b.update_time)
                FROM
                    safety_retention_notice b
                WHERE
                    b.car_type = a.car_type
                  and b.is_used = a.is_used
            )
        and a.is_used = 1
    </select>

    <!-- 获取滞留次数和通知次数 -->
    <select id="getNoticeLogReport" resultType="com.yutong.safety.common.vo.NoticeLogVO">
        SELECT
            TMP1.*, TMP3.retention_nums
        FROM
            (
                SELECT
                    R.car_no,
                    R.in_time,
                    R.inform_type,
                    R.notice_id,
                    COUNT(1) AS notice_nums,
                    DATE_FORMAT(
                        max(r.create_time),
                        '%Y-%m-%d %H:%i:%s'
                    ) AS notice_time
                FROM safety_retention_inform_record R
                GROUP BY R.car_no, R.in_time, R.inform_type, R.notice_id
            ) TMP1,(
            SELECT car_no,COUNT(1) retention_nums,max(in_time) as in_time
            FROM
                (
                    SELECT DISTINCT	r1.car_no,r1.in_time
                    FROM safety_retention_inform_record r1
                ) AS TMP2
            GROUP BY
                car_no
        ) TMP3 where TMP1.car_no = TMP3.car_no and TMP1.in_time = TMP3.in_time
    </select>

