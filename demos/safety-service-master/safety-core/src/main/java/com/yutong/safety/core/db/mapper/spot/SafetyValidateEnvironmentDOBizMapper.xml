    select
        en.business_type,
        p.subject,
        en.create_time,
        en.location,
        case
            when en.car_number is null or en.car_number = '' then p.vehicle_no
            else en.car_number
        end as car_number,
        p.goout_emp_name,
        p.goout_phone,
        p.goout_emp_dept,
        p.out_factory_name,
        p.goods_type,
        p.reason_type,
        p.reason_desc,
        dr.target_factory,
        en.factory,
        en.factory_id,
        case
          when p.out_person_type='1' then concat(p.goout_emp_dept,'-',p.goout_emp_name,'-',p.out_type_name)
          when p.out_person_type='2' then concat('外部人员-',p.outside_name,'-',p.out_type_name)
        else ''
        end as goods_detail,
        en.valid_access,
        case
          when en.exception_type is null or en.exception_type = '' then ex.exception_type
          else en.exception_type
        end as exception_type,
        en.remark,
        en.emission_standard,
        en.is_blacklist as blacklist,
        en.check_person,
        en.check_person_no,
        en.weight_list_weight,
        en.recheck_weight,
        en.id,
        p.id goodsOutId,
    <![CDATA[ CONCAT(#{goodsOutBpmUrlPre},'&formInstanceId=',p.id,'&processId=',p.flow_id) goods_out_flow_url ]]>
    from safety_validate_environment en
           inner join safety_goods_out_process p on en.flow_no = p.id
    left join safety_goods_out_detail_receive dr on p.id = dr.process_id
    left join safety_goods_out_exception ex on p.id = ex.process_id
    <include refid="whereCondition"/>
