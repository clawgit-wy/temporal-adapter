<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yutong.safety.core.db.mapper.SafetyBpmWebServiceMapper">
  <update id="updateFlowStatus">
    update ${table} set status = #{status}, publish_time = now()
                    <if test="table == 'safety_monitor_post_process'">
                      ,audit_time = now()
                    </if>
                      <if test="table == 'safety_process_patrol'">
                          ,cur_node_id = 'N3'
                      </if>
                    where flow_id = #{flowId}
  </update>

  <select id="findAllModels" resultType="java.util.Map">
    select * from safety.safety_bpm_model
  </select>

  <select id="findTableColumns" resultType="java.util.Map">
    select i.column_name name ,i.column_comment comment,i.column_type type from information_schema.columns i where table_schema='safety' and table_name= #{templateFormId}
  </select>

  <select id="findFieldValues" resultType="java.util.Map">
    select
    <choose>
      <when test="columns!='' and columns!=null">
        ${columns}
      </when>
      <otherwise>
        *
      </otherwise>
    </choose>
    from ${tableName}
    where id = #{flowId}
  </select>
  <select id="findCallBacks" resultType="java.util.Map">
    select * from safety.safety_bpm_call_back where model_id = #{modelId}
  </select>
  <select id="findIdByFormId" resultType="java.lang.String">
    select auto_increment from information_schema.TABLES where table_name = #{table}
  </select>

  <select id="findBpmModelByFormId" resultType="java.util.Map">
    select * from safety.safety_bpm_model where form_id = #{formId}
  </select>

  <resultMap id="BpmModelMap" type="com.yutong.safety.core.db.entity.result.BpmModelRt">
      <result column="model_id" property="modelId" />
      <result column="form_id" property="formId" />
      <result column="form_url" property="formUrl" />
      <result column="template_id" property="templateId" />
  </resultMap>
  <select id="selectModelInfo" resultMap="BpmModelMap">
      select model_id,form_id,form_url,template_id
      from safety_bpm_model
      where model_id=#{modelId} and form_id=#{formId}
  </select>

  <select id="getProcessId" parameterType="java.lang.String" resultType="java.lang.String">
    select flow_id from ${type} where id = #{formInstanceId}
  </select>
</mapper>