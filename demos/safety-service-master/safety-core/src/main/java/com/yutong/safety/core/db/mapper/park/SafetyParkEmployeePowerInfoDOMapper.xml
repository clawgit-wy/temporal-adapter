        b.phone_no AS phoneNo,
        b.org_name_path as orgNamePath,
        b.org_code_path as orgCodePath,
        'ZS'       AS userType
    FROM
        (
        SELECT
            EMPLOYEE_CODE AS empNo,
            IS_DELETE AS type,
            GROUP_CONCAT( FACTORY_ID ) AS factoryId,
            GROUP_CONCAT( factory_name ) AS factoryName,
