<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yutong.safety.core.db.mapper.SafetyRegionDeviceDOBizMapper">
  <insert id="batchInsert">
    INSERT INTO `safety_region_device` (`factory_name`, `region_name`, `device_type`, `device_no`, `device_name`, `remark`, `create_time`, `update_time`, `delete_falg`, `factory_id`, `region_id`) values
    <foreach collection="blackList" item="item" separator=",">
      (#{item.factoryName}, #{item.regionName}, #{item.deviceType}, #{item.deviceNo}, #{item.deviceName}, #{item.remark}, now(), now(), '0', #{item.factoryId}, #{item.regionId})
    </foreach>
  </insert>
</mapper>