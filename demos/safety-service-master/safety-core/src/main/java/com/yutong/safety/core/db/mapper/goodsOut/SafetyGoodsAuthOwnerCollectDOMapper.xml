  <select id="getRecentSelect" parameterType="com.yutong.safety.core.dto.goodsOut.SafetyGoodsSelectPersonDTO" resultType="java.util.Map">
    select distinct b.emp_dept         as empDept,
                    b.emp_name         as empName,
                    b.emp_no           as empNo,
                    b.power_factory_id as powerFactoryId,
                    b.id               as authId,
                    b.power_desc       as powerDesc,
                    a.create_time      as createTime,
                    b.emp_eip          as empEip,
                    c.phone_no         as phoneNum
    from safety_goods_auth_owner_collect a
           left join safety_goods_out_auth b
                     on a.auth_id = b.id
    LEFT JOIN safety_employee_message c on b.emp_no = c.emp_no
    where a.owner_emp_no = #{ownerEmpNo}
      and b.out_type = #{outType}
      and b.power_factory_id = #{outFactory}
      and a.collect_type = '2'
    order by a.create_time desc
  </select>

