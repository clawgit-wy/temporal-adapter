                              b.id               as authId,
                              b.power_desc       as powerDesc,
                              a.collect_type     as collectType,
                              b.emp_eip          as empEip,
                              d.phone_no         as phoneNum
              from safety_goods_auth_owner_collect a
                     left join safety_goods_out_auth b
                               on a.auth_id = b.id
              LEFT JOIN safety_employee_message d on b.emp_no = d.emp_no
              where a.owner_emp_no = #{ownerEmpNo}
                and a.collect_type = '1'
                and b.power_factory_id = #{outFactory}
                and b.out_type = #{outType}
                <if test="searchContent != null and searchContent != ''">
                  and (
                       b.emp_dept like concat('%', #{searchContent}, '%')
                    or b.emp_name like concat('%', #{searchContent}, '%')
                    or b.emp_no   like concat('%', #{searchContent}, '%')
                  )
                </if>
              union all
            </if>
            select distinct c.emp_dept         as empDept,
                            c.emp_name         as empName,
                            c.emp_no           as empNo,
                            c.power_factory_id as powerFactoryId,
                            c.id               as authId,
                            c.power_desc       as powerDesc,
                            '22'               as collectType,
                            c.emp_eip          as empEip,
                            e.phone_no         as phoneNum
            from safety_goods_out_auth c
            LEFT JOIN safety_employee_message e on c.emp_no = e.emp_no
            where c.power_factory_id = #{outFactory}
