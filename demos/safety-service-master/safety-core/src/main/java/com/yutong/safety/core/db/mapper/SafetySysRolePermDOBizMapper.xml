<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yutong.safety.core.db.mapper.SafetySysRolePermDOBizMapper">
  <insert id="setRolePerms" parameterType="java.util.Map">
    INSERT INTO safety_sys_role_perm (role_id,perm_id)
    VALUES
    <foreach collection="permIds" item="permId" index="index" separator=",">
      (#{roleId},#{permId})
    </foreach>
  </insert>
</mapper>