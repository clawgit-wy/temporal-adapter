  <select id="selectEntryOverdueTask" resultType="com.yutong.safety.core.db.entity.entry.vo.EntryOverdueTaskVO">
    select a.fd_emp_no          as buttJointCode,
           c.email,
           b.company_name       as companyName,
           b.name,
           b.phone,
           b.record_type_code   as recordTypeCode,
           b.enter_factory_code as enterFactoryCode,
           b.enter_start_time   as enterStartTime,
           b.enter_end_time     as enterEndTime
    from safety_enter_auth a
             left join safety_entry_config b on a.fd_emp_no = b.butt_joint_code
             left join safety_employee_message c on a.fd_emp_no = c.emp_no
    where a.del = 0
      and a.fd_config_type = '1'
      and a.fd_notification = '1'
      and b.del_flag = 0
      and b.status = '30'
      and c.status = 'NORMAL'
      and DATE(b.enter_end_time) = CURDATE();
  </select>
