  <select id="selectParkPowerByFactoryName" parameterType="java.util.List" resultType="com.yutong.safety.core.db.entity.park.ParkEmployeeClassifiedDO">
    SELECT
      a.emp_no as empNo,
      a.emp_name as empName,
      a.org_name_path as orgNamePath,
      a.org_code_path as orgCodePath,
      a.org_code as orgCode,
      a.org_name as orgName,
      a.user_type as userType,
      b.factory_name as factoryName,
      b.FACTORY_ID as factoryCode,
      b.POWER_BEGIN_TIME as beginDate,
      b.POWER_END_TIME as endDate
    FROM
      safety_employee_message a
      LEFT JOIN safety_park_employee_power_info b ON a.emp_no = b.EMPLOYEE_CODE
    WHERE
      a.STATUS = 'NORMAL'
      AND b.IS_DELETE = 0
      and b.FACTORY_ID in
      <foreach collection="list" item="item" open="(" close=")" separator=",">
        #{item}
      </foreach>
  </select>

  <delete id="deleteInfo">
    delete from safety_park_employee_classified_business
  </delete>

  <delete id="deleteInfoById">
