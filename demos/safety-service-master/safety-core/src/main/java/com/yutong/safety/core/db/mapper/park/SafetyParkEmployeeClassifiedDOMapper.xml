  <select id="selectBuildPowerByEmpNo" parameterType="java.util.List" resultType="com.yutong.safety.core.db.entity.park.ParkEmployeeClassifiedDO">
    SELECT
        a.EMPLOYEE_CODE as empNo, b.AN_FACTORY_CODE as factoryCode
    FROM
        safety_build_employee_power a
    LEFT JOIN (
        SELECT DEVICE_CODE, AN_FACTORY_CODE FROM safety_build_device WHERE DEVICE_STATUS = 1 AND REMOVE_FLAG = 0 AND IS_DELETE = 0 AND AN_FACTORY_CODE IN
        <foreach collection="factoryCodeList" item="item" open="(" close=")" separator=",">
          #{item}
        </foreach>
    ) b ON a.DEVICE_CODE = b.DEVICE_CODE
    WHERE  a.EMPLOYEE_CODE IN
    <foreach collection="empNoList" item="item" open="(" close=")" separator=",">
      #{item}
    </foreach>
    GROUP BY a.EMPLOYEE_CODE, b.AN_FACTORY_CODE
  </select>

