    <if test="fireApproveListParam.commonParam != null and fireApproveListParam.commonParam != '' ">
      and (t1.principal_name = #{fireApproveListParam.commonParam}
      or t1.principal_num = #{fireApproveListParam.commonParam}
      or t1.work_company like concat('%',#{fireApproveListParam.commonParam},'%')
      or t3.lens_num like concat('%',#{fireApproveListParam.commonParam},'%')
      or t3.lens_name like concat('%',#{fireApproveListParam.commonParam},'%'))
    </if>

    order by t1.id,t3.id
