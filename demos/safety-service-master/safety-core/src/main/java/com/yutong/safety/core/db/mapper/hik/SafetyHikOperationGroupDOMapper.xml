    <select id="getIncrementGroupInfo" parameterType="map" resultType="com.yutong.safety.core.db.entity.hik.SafetyHikOperationGroupDO">
        SELECT a.EMPLOYEE_CODE AS empNo,
               a.EMPLOYEE_NAME AS empName,
               a.DELETE_FLAG   AS delFlag,
               d.index_code    AS faceGroup
        FROM safety.safety_build_employee_power a
                 LEFT JOIN safety.safety_build_device b
                           ON a.DEVICE_CODE = b.DEVICE_CODE AND b.IS_DELETE = 0 AND b.REMOVE_FLAG = 0 AND b.DEVICE_STATUS = 1
                 INNER JOIN safety.safety_hik_group d ON d.build_code = b.AN_BUILDING_CODE
        WHERE b.AN_BUILDING_CODE IS NOT NULL
          AND a.EMPLOYEE_CODE IN (
            SELECT EMPLOYEE_CODE
            FROM safety.safety_build_employee_power
            WHERE update_time BETWEEN #{start} and #{end}
        )
        GROUP BY a.EMPLOYEE_CODE, a.EMPLOYEE_NAME, d.index_code, a.DELETE_FLAG
