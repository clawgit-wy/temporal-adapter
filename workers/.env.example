##############################################################################
# Docker Compose 环境变量配置
#
# 使用方式:
#   cp .env.example .env
#   vi .env
##############################################################################

# Temporal Server 地址
# 同一台服务器用容器名: temporal:7233
# 远程服务器用 IP:端口，如 10.66.32.100:7233
TEMPORAL_ADDRESS=temporal:7233

# 富士设备(CRK出入口) API 地址
# 测试环境: http://10.66.230.210:60009
# 生产环境: http://10.66.32.54:60009
FUJI_API_BASE_URL=http://10.66.32.54:60009

# 新开普(IdentityWebService) API 地址
# 测试环境: http://10.66.226.90
# 生产环境: http://10.66.32.110
XINKAIPU_API_BASE_URL=http://10.66.32.110

# Webhook 回调地址
WEBHOOK_CALLBACK_URL=https://your-business-system.com/api/webhook/callback

# Docker 镜像配置（可选）
# IMAGE_NAME=device-access-worker
# IMAGE_TAG=latest
